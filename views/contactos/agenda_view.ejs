<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= title %>
    </title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body>
    <div class="container">
        <div class="header">
            <div>
                <h1>Agenda de Contactos</h1>
                <p class="subhead">Gestión y directorio corporativo de contactos</p>
            </div>
            <div style="display: flex; gap: 10px; align-items: center;">
                <% if (typeof usuario !=='undefined' && usuario) { %>
                    <span style="font-size: 0.88rem; color: var(--text-muted); font-weight: 500;">
                        👤 <%= usuario.nombre %>
                    </span>
                    <a href="/auth/logout" class="btn btn-secondary"
                        style="padding: 8px 14px; font-size: 0.85rem;">Salir</a>
                    <% } else { %>
                        <a href="/auth/login" class="btn btn-primary">Iniciar Sesión</a>
                        <a href="/auth/register" class="btn btn-secondary">Registrarse</a>
                        <% } %>
            </div>
        </div>

        <% if (typeof contactos !=='undefined' && contactos.length> 0) { %>
            <div class="contact-column">
                <% contactos.forEach(contacto=> { %>
                    <% if (typeof usuario !=='undefined' && usuario) { %>
                        <a href="/contactos/<%= contacto.id %>" class="contact-card-link">
                            <% } else { %>
                                <a href="/auth/login" class="contact-card-link"
                                    title="Debes iniciar sesión para ver los detalles de este contacto">
                                    <% } %>
                                        <div class="contact-card">
                                            <div class="avatar">
                                                <%= contacto.nombre ? contacto.nombre.charAt(0).toUpperCase() : 'C' %>
                                            </div>
                                            <div class="contact-info">
                                                <div class="contact-name">
                                                    <%= contacto.nombre %>
                                                </div>
                                                <div class="contact-details">
                                                    <% if (contacto.telefono) { %>
                                                        <span>📞 <%= contacto.telefono %></span>
                                                        <% } %>
                                                            <% if (contacto.provincia) { %>
                                                                <span class="badge-provincia">
                                                                    <%= contacto.provincia.nombre %>
                                                                </span>
                                                                <% } %>
                                                </div>
                                            </div>
                                            <% if (typeof usuario !=='undefined' && usuario) { %>
                                                <div class="arrow-icon">➔</div>
                                                <% } else { %>
                                                    <div class="arrow-icon"
                                                        style="font-size: 0.9rem; background: #f1f5f9; padding: 4px 8px; border-radius: 6px; color: var(--text-muted);">
                                                        🔒 Iniciar sesión</div>
                                                    <% } %>
                                        </div>
                                </a>
                                <% }); %>
            </div>
            <a href="/contactos/new" class="btn btn-primary" style="margin-top: 2.5rem;">+ Nuevo</a>
            <% } else { %>
                <div class="empty-state">
                    <p>No hay contactos registrados en la agenda.</p>
                    <% if (typeof usuario !=='undefined' && usuario) { %>
                        <a href="/contactos/new" class="btn btn-primary" style="margin-top: 2.5rem;">+ Nuevo Contacto</a>
                        <% } else { %>
                            <a href="/auth/login" class="btn btn-primary" style="margin-top: 2.5rem;">Iniciar Sesión para Agregar Contactos</a>
                            <% } %>
                </div>
                <% } %>
    </div>
</body>

</html>